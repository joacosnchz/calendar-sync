# Copy to .env (or run `make env`, which also generates fresh secrets).
# Defaults run everything locally against the mock Microsoft 365 service.

COMPOSE_PROFILES=mock
POSTGRES_PASSWORD=calsync
LOG_LEVEL=INFO

# --- secrets (make env replaces these) ------------------------------------------------
SESSION_SECRET=replace-with-64-random-characters-replace-with-64-random-characters
# Fernet keys, comma-separated; the first encrypts, all decrypt (rotation).
DATA_ENCRYPTION_KEYS=replace-with-a-fernet-key

# --- URLs ----------------------------------------------------------------------------
# Where Microsoft Graph delivers webhooks. Production: a public HTTPS URL that routes to
# the api service (e.g. https://api.example.com). With the mock, the internal address.
PUBLIC_API_URL=http://api:8000
# Browser-facing URL of the web app; OAuth redirect URIs are
#   {PUBLIC_WEB_URL}/auth/callback  and  {PUBLIC_WEB_URL}/auth/adminconsent/callback
PUBLIC_WEB_URL=http://localhost:3000

# Identity + Graph endpoints. For real Microsoft 365 remove these three lines.
LOGIN_BASE_URL=http://mockgraph:8001
LOGIN_BROWSER_BASE_URL=http://localhost:8001
GRAPH_BASE_URL=http://mockgraph:8001/v1.0

# --- app registrations -----------------------------------------------------------------
# Our own tenant (hosts primary calendars).
HOME_TENANT_ID=11111111-1111-4111-8111-111111111111
# Multi-tenant app customers consent to: Calendars.Read (application) + openid/profile/User.Read.
SOURCE_APP_CLIENT_ID=22222222-2222-4222-8222-222222222222
SOURCE_APP_CLIENT_SECRET=mock-source-secret
# Or certificate credentials (preferred in production):
# SOURCE_APP_CERT_PATH=/run/secrets/source-app.pem
# SOURCE_APP_CERT_THUMBPRINT=
# Single-tenant app in our tenant: Calendars.ReadWrite (application), restricted by an
# application access policy to the primary-calendar mailboxes.
PRIMARY_APP_CLIENT_ID=33333333-3333-4333-8333-333333333333
PRIMARY_APP_CLIENT_SECRET=mock-primary-secret

# --- primary calendars -----------------------------------------------------------------
# shared_mailbox: one calendar per user inside PRIMARY_SHARED_MAILBOX (automatic)
# user_mailbox:   an operator assigns each user a licensed mailbox in our tenant
PRIMARY_CALENDAR_MODE=shared_mailbox
PRIMARY_SHARED_MAILBOX=calendars@calsync.example

# Users signing in with these addresses become operators (comma-separated).
OPERATOR_EMAILS=ops@calsync.example

# --- sync tuning (PRD defaults) --------------------------------------------------------
SYNC_WINDOW_PAST_DAYS=90
SYNC_WINDOW_FUTURE_DAYS=365
SUBSCRIPTION_LIFETIME_MINUTES=4200
SUBSCRIPTION_RENEW_INTERVAL_HOURS=24
DELTA_RESYNC_INTERVAL_HOURS=6
MIRROR_LABEL_IN_SUBJECT=true
