# docker compose settings (the web app, and the mock Microsoft 365 for development).
# Copy to .env, or run `make env`. The backend's own settings live in
# supabase/functions/.env (see supabase/functions/.env.example).

# `mock` starts the stand-in for login.microsoftonline.com + Graph. Remove it (or set
# another profile) when running against real Microsoft 365.
COMPOSE_PROFILES=mock

# The mock accepts this app registration. Must match SOURCE_APP_CLIENT_ID and
# SOURCE_APP_CLIENT_SECRET in supabase/functions/.env.
SOURCE_APP_CLIENT_ID=22222222-2222-4222-8222-222222222222
SOURCE_APP_CLIENT_SECRET=mock-source-secret

# Where the web app proxies /api/* and /auth/* (the Edge Functions). Fixed at build time.
# Local Supabase, seen from the web container: http://host.docker.internal:54321/functions/v1
# Hosted: https://<project-ref>.supabase.co/functions/v1
SUPABASE_FUNCTIONS_URL=http://host.docker.internal:54321/functions/v1

WEB_PORT=3000
MOCKGRAPH_PORT=8001
